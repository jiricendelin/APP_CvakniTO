# Lokálně (volitelné): musí běžet PostgreSQL na portu 5432, databáze cvaknito.
# Bez lokální DB použij deploy na Coolify (db push) + seed na VPS, viz rezy R3.
DATABASE_URL="postgresql://cvaknito:cvaknito@localhost:5432/cvaknito?schema=public"

# Coolify: Postgres jako samostatný resource → v app Environment vlož Internal Connection URL
# (uživatel postgres, databáze podle názvu resource). Heslo bez teček a speciálních znaků.
